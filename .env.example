# Ask FixIt AI (Gemini) configuration
# 1. Get an API key from Google AI Studio: https://aistudio.google.com/apikey
# 2. Copy this file to ".env" in the same folder as server.js (do not commit .env).
# 3. Set GEMINI_API_KEY below to your real key. Keep it server-side only:
#    never put it in frontend/browser code, commit it, share it, or log it.
# 4. Restart the server after changing .env.
#
# Ask FixIt AI is text-only (no image/file/multimodal input), stores no chat messages,
# and uses admin-managed verified service information for service answers.

GEMINI_API_KEY=paste-your-gemini-api-key-here

# Optional: Gemini model used by Ask FixIt AI (default in code: gemini-2.5-flash).
# If your key/project cannot use that model, try: gemini-3-flash-preview or gemini-flash-latest
# and restart the server.
GEMINI_MODEL=gemini-3-flash-preview

# Optional: Xenova Transformers.js image verification settings
# Set to "1" or "true" to disable AI image verification (useful for tests/offline).
# IMAGE_VERIFY_DISABLED=1
# Model ID from Hugging Face (default: Xenova/clip-vit-base-patch32)
# IMAGE_VERIFY_MODEL=Xenova/clip-vit-base-patch32
# Cache directory for downloaded models (optional)
# IMAGE_VERIFY_CACHE_DIR=/path/to/cache
# Allow remote model downloads (default: true, set to "false" for fully offline)
# IMAGE_VERIFY_ALLOW_REMOTE=true
# Analysis timeout in milliseconds (default: 30000)
# IMAGE_VERIFY_TIMEOUT_MS=30000
# Threshold for MATCH status (default: 0.28)
# IMAGE_VERIFY_MATCH_THRESHOLD=0.28
# Threshold below which selected category is considered weak (default: 0.22)
# IMAGE_VERIFY_MISMATCH_THRESHOLD=0.22
# Margin required for another category to be considered a mismatch (default: 0.06)
# IMAGE_VERIFY_MISMATCH_MARGIN=0.06
# Threshold for REJECTED status (Unrelated Image) (default: 0.30)
# IMAGE_VERIFY_REJECTED_THRESHOLD=0.30

# Optional server settings
# PORT=3000
# DB_FILE=fixit.db
